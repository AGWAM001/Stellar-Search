# ════════════════════════════════════════════════════
#  StellarSearch — Production Environment Variables
# ════════════════════════════════════════════════════

# ─── Stellar: server receiving wallet ────────────────
STELLAR_RECEIVING_ADDRESS=GBXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Stellar network ─────────────────────────────────
STELLAR_NETWORK=stellar:testnet

# ─── x402 Facilitator ────────────────────────────────────
FACILITATOR_URL=https://www.x402.org/facilitator

# ─── Serper.dev Search API ──────────────────────────────
SERPER_API_KEY=your_serper_api_key_here

# ─── Groq AI ─────────────────────────────────────────
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Server ──────────────────────────────────────────
PORT=3000

# ─── Frontend (Vite env vars) ────────────────────────
VITE_SERVER_URL=/api

# ─── MCP server ──────────────────────────────────────
SEARCH_API_URL=https://stellar-search-2twg.vercel.app/api